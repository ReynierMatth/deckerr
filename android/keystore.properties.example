# Copy this file to android/keystore.properties (which is GITIGNORED) and fill
# in the values from the keystore you generated with keytool. NEVER commit the
# real keystore.properties or the .jks file — losing/leaking them compromises
# your app's upload identity.
storeFile=deckerr-upload.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=deckerr-upload
keyPassword=YOUR_KEY_PASSWORD
