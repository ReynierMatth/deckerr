# Capacitor / Android build — DO NOT bake any Supabase instance.
#
# The native app is multi-instance (Jellyfin-style): the end user enters their
# own instance URL at runtime. These vars are intentionally left EMPTY so they
# override the dev `.env` and keep `readBakedConfig()` null — otherwise the
# instance would be "locked" and the URL-entry screen skipped.
#
# Build with: vite build --mode capacitor  (see the cap:build npm script).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
